From d362cb1ad78e4b6611ec52ebcd50653ee62aff55 Mon Sep 17 00:00:00 2001
From: Charles Ji <me@charlesji.com>
Date: Thu, 9 Jul 2026 17:09:24 -0400
Subject: [PATCH 1/3] Add green goal-mouth markers to the table

Visual-only strips just inside the playing field at both goal mouths,
so scoring regions are clearly visible in rendered frames (the rim top
bars occlude the mouth itself from a top-down camera).
---
 air_hockey_challenge/environments/data/table.xml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/air_hockey_challenge/environments/data/table.xml b/air_hockey_challenge/environments/data/table.xml
index df4c534..fd1bb73 100644
--- a/air_hockey_challenge/environments/data/table.xml
+++ b/air_hockey_challenge/environments/data/table.xml
@@ -53,6 +53,14 @@
                 <geom name="rim_away_r" class="rim" type="mesh" mesh="rim" pos="-1.019 -0.322 0." quat="0 0 0 1"/>
                 <geom name="rim_away_top" class="rim" size="0.045 0.519 0.01" pos="1.019 0 0.02"
                       contype="0" conaffinity="0"/>
+
+                <!-- Visual-only goal-mouth markers, placed just inside the
+                     playing field so they stay visible from a top-down camera
+                     (the rim_*_top bars occlude the mouth itself from above). -->
+                <geom name="goal_marker_home" type="box" size="0.04 0.125 0.001" pos="-0.934 0 0.001"
+                      rgba="0.0 0.8 0.2 1" contype="0" conaffinity="0"/>
+                <geom name="goal_marker_away" type="box" size="0.04 0.125 0.001" pos="0.934 0 0.001"
+                      rgba="0.0 0.8 0.2 1" contype="0" conaffinity="0"/>
             </body>
         </body>
 
